#!/home/lumieredunord/q10/q10_env/bin/python3
# EASY-INSTALL-ENTRY-SCRIPT: 'greetlab','console_scripts','sdt-greet'
__requires__ = 'greetlab'
import re
import sys
from pkg_resources import load_entry_point

if __name__ == '__main__':
    sys.argv[0] = re.sub(r'(-script\.pyw?|\.exe)?$', '', sys.argv[0])
    sys.exit(
        load_entry_point('greetlab', 'console_scripts', 'sdt-greet')()
    )
